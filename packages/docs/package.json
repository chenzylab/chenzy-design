{
  "name": "@chenzy-design/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "meta": "pnpm --filter @chenzy-design/svelte build:meta && tsx scripts/build-skills-zip.ts",
    "predev": "pnpm run meta",
    "dev": "svelte-kit sync && vite dev",
    "prebuild": "pnpm run meta",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "check:anchors": "node scripts/check-anchors.mjs",
    "pretypecheck": "pnpm run meta",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@chenzy-design/core": "workspace:*",
    "@chenzy-design/icons": "workspace:*",
    "@chenzy-design/icons-lab": "workspace:*",
    "@chenzy-design/illustrations": "workspace:*",
    "@chenzy-design/svelte": "workspace:*",
    "@chenzy-design/tokens": "workspace:*",
    "@chenzy-design/unocss-preset": "workspace:*",
    "@fontsource/inter": "^5.3.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-mention": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "copy-text-to-clipboard": "^3.2.2",
    "date-fns": "^4.4.0",
    "prismjs": "^1.29.0",
    "svelte-tiptap": "^3.0.2"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.147",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@unocss/preset-icons": "^66.11.0",
    "@unocss/preset-typography": "66.11.0",
    "@unocss/reset": "66.11.0",
    "fflate": "^0.8.3",
    "lottie-web": "^5.13.0",
    "mdsvex": "^0.12.8",
    "shiki": "^4.5.0",
    "tsx": "^4.23.15",
    "unocss": "^66.11.0"
  }
}
